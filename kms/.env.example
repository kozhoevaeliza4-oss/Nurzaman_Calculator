PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=kms
DB_PASSWORD=change-me
DB_NAME=asyl_amanat_kms

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# Module 1: document storage (defaults to ./storage/documents on local
# disk — set this to a durable path, or swap StorageAdapter for S3, in
# production).
DOCUMENTS_STORAGE_PATH=

# Module 9: notification channels. Any of these left unset just means
# that channel is skipped (logged as not_configured) — nothing else
# breaks.
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# WhatsApp: only the official Business API — see README for why.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Modules 7 & 12: AI assistant + AI analytics. Leave unset to disable
# both gracefully (endpoints still respond, just without an AI answer).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
