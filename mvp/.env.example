PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_USER=mvp
DB_PASSWORD=change-me
DB_NAME=asyl_amanat_finance_mvp
# Optional: set only when sharing a Postgres instance with another app
# (isolates this app's tables in their own schema instead of a dedicated
# database) — e.g. DB_SCHEMA=finance_mvp
DB_SCHEMA=

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h

# First admin account, created once at boot if it doesn't exist yet
# (see src/seed/seed-admin.ts, run automatically by start.sh).
ADMIN_EMAIL=
ADMIN_PASSWORD=

UPLOADS_STORAGE_PATH=
